# ==============================================================================
# Variables de entorno para el stack de producción / staging (docker-compose.prod.yml)
# Copia este archivo a un archivo .env en Portainer o en el servidor VPS.
# ==============================================================================

# Base de datos PostgreSQL (requeridos)
DB_NAME=sigoa_prod
DB_USER=sigoa_user
DB_PASSWORD=cambiar_password_seguro_en_produccion

# Servidor Backend (API Express)
SERVER_PORT=3000
LOG_LEVEL=info
HSTS_ENABLED=true
TRUST_PROXY=2

# Frontend SPA (Nginx) y CORS (requeridos)
FRONTEND_PORT=8001
VITE_API_URL=https://sigoa.untrm.edu.pe/api
CORS_ORIGIN=https://sigoa.untrm.edu.pe

# Límites de recursos por contenedor
DB_MEMORY_LIMIT=512M
BACKEND_MEMORY_LIMIT=1G
FRONTEND_MEMORY_LIMIT=128M
