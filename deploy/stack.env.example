# ==============================================================================
# Variables de entorno para el stack de producción / staging (docker-compose.prod.yml)
# Copia este archivo a un archivo .env en Portainer o en el servidor VPS.
# ==============================================================================

# Base de datos PostgreSQL (requeridos)
DB_NAME=sigoa_prod
DB_USER=sigoa_user
DB_PASSWORD=cambiar_password_seguro_en_produccion

# Rol de aplicación restringido para el backend (requeridos, RS-040, RNF-014)
# APP_DB_USER: solo minúsculas y _, entre 3 y 63 caracteres, distinto de DB_USER
# APP_DB_PASSWORD: solo letras, números, _ y -, mínimo 16 caracteres, sin caracteres especiales que rompan URLs
APP_DB_USER=sigoa_backend
APP_DB_PASSWORD=cambiar_password_app_min_16_caracteres_seguro

# Servidor Backend (API Express)
SERVER_PORT=3000
LOG_LEVEL=info
HSTS_ENABLED=true
TRUST_PROXY=2

# Proveedor de correo electrónico (RS-073, RNF-033: resend | memory)
# En producción se debe usar resend y suministrar API key y remitente válido
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_cambiar_api_key_segura
EMAIL_FROM=sigoa@untrim.edu.pe

# Proveedor de almacenamiento de archivos (RS-072, RNF-013: cloudinary | memory)
# En producción se debe usar cloudinary y suministrar las tres credenciales
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=cambiar_cloud_name
CLOUDINARY_API_KEY=cambiar_api_key
CLOUDINARY_API_SECRET=cambiar_api_secret

# Generador PDF Puppeteer (RS-063, RNF-021)
# En contenedores endurecidos con perfil seccomp para user namespaces se usa false (sandbox activo)
PDF_CHROMIUM_NO_SANDBOX=false

# Frontend SPA (Nginx) y CORS (requeridos)
FRONTEND_PORT=8001
VITE_API_URL=https://api.sigoa.example.com
CORS_ORIGIN=https://sigoa.example.com
APP_PUBLIC_URL=https://sigoa.example.com

# Límites de recursos por contenedor
DB_MEMORY_LIMIT=512M
BACKEND_MEMORY_LIMIT=1G
FRONTEND_MEMORY_LIMIT=128M

# Servicio de Respaldo PostgreSQL (postgres-backup-local)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=0
BACKUP_KEEP_MONTHS=0
