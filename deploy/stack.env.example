# ==============================================================================
# Variables de entorno para el stack de producción / staging (docker-compose.prod.yml)
# Copia este archivo a un archivo .env en Portainer o en el servidor VPS.
# ==============================================================================

# Base de datos PostgreSQL (requeridos)
DB_NAME=sigoa_prod
DB_USER=sigoa_user
DB_PASSWORD=cambiar_password_seguro_en_produccion

# Rol de aplicación restringido para el backend (requeridos, RS-040, RNF-014)
# APP_DB_USER: solo minúsculas y _, entre 3 y 63 caracteres, distinto de DB_USER
# APP_DB_PASSWORD: solo letras, números, _ y -, mínimo 16 caracteres, sin caracteres especiales que rompan URLs
APP_DB_USER=sigoa_backend
APP_DB_PASSWORD=cambiar_password_app_min_16_caracteres_seguro

# Primer administrador del sistema (RNF-039). Solo las recibe el servicio `migrate`; el backend no.
# Son obligatorias únicamente mientras no exista ningún usuario con rol Administrador (primer despliegue).
# Con un administrador ya creado, `migrate` ignora estas variables y nunca cambia su contraseña.
# ADMIN_FULL_NAME: 2 palabras = nombre + apellido; 3 = un nombre + dos apellidos; 4 o más = las dos últimas son apellidos
# ADMIN_DNI: 8 dígitos · ADMIN_INITIAL_PASSWORD: 10 a 128 caracteres con letras y números
# Después del primer acceso quita ADMIN_INITIAL_PASSWORD del stack y cambia la contraseña desde la aplicación.
ADMIN_EMAIL=admin@sigoa.example.com
ADMIN_FULL_NAME=Nombres Apellido Paterno Apellido Materno
ADMIN_DNI=00000000
ADMIN_INITIAL_PASSWORD=cambiar_password_inicial_min_10

# Servidor Backend (API Express)
SERVER_PORT=3000
LOG_LEVEL=info
HSTS_ENABLED=true
TRUST_PROXY=2

# Rate Limiting (solicitudes por ventana de tiempo en ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SESSION_MAX=30
RATE_LIMIT_GENERAL_MAX=300

# Proveedor de correo electrónico (RS-073, RNF-033: resend | memory)
# En producción se debe usar resend y suministrar API key y remitente válido
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_cambiar_api_key_segura
EMAIL_FROM=sigoa@untrim.edu.pe

# Proveedor de almacenamiento de archivos (RS-072, RNF-013: cloudinary | memory)
# En producción se debe usar cloudinary y suministrar las tres credenciales
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=cambiar_cloud_name
CLOUDINARY_API_KEY=cambiar_api_key
CLOUDINARY_API_SECRET=cambiar_api_secret

# Generador PDF Puppeteer (RS-063, RNF-021)
# En contenedores endurecidos con perfil seccomp para user namespaces se usa false (sandbox activo)
PDF_CHROMIUM_NO_SANDBOX=false

# Autenticación y tokens de sesión (RNF-004, RNF-005, RF-001)
# En producción AUTH_JWT_SECRET debe ser un secreto aleatorio seguro de al menos 32 caracteres
AUTH_JWT_SECRET=cambiar_jwt_secret_minimo_32_caracteres_seguro
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_COOKIE_SAMESITE=strict

# Frontend SPA (Nginx) y CORS (requeridos)
FRONTEND_PORT=8001
VITE_API_URL=https://api.sigoa.example.com
CORS_ORIGIN=https://sigoa.example.com
# En producción y staging debe ser https. Para probar este mismo stack en tu equipo (sin TLS) usa
# http://localhost:<FRONTEND_PORT>: es la única excepción aceptada y los enlaces de los correos funcionan.
# El escudo de los correos lo descarga el cliente de correo desde esta URL: Gmail no puede cargarlo
# desde localhost, solo desde un dominio público.
APP_PUBLIC_URL=https://sigoa.example.com

# Límites de recursos por contenedor
DB_MEMORY_LIMIT=512M
BACKEND_MEMORY_LIMIT=1G
FRONTEND_MEMORY_LIMIT=128M

# Servicio de Respaldo PostgreSQL (postgres-backup-local)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=0
BACKUP_KEEP_MONTHS=0
