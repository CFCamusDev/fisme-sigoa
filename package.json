{
  "name": "fisme-sigoa",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Integrado de Gestion de Objetivos Educacionales y Atributos del Graduado (EPIS UNTRM)",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ],
    "overrides": {
      "effect": "^3.22.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  },
  "scripts": {
    "build:shared": "pnpm --filter @sigoa/shared build",
    "db:generate": "pnpm --filter backend db:generate",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "typecheck": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present typecheck",
    "test": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present test",
    "test:fast": "pnpm build:shared && pnpm db:generate && pnpm --filter backend test:unit && pnpm --filter frontend test && pnpm --filter @sigoa/shared test",
    "test:affected": "pnpm build:shared && pnpm db:generate && node scripts/perf/test-affected.mjs",
    "test:coverage": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present test:coverage",
    "test:e2e": "pnpm build:shared && pnpm db:generate && pnpm --filter frontend test:e2e",
    "build": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present build",
    "depcruise": "pnpm --filter backend --if-present depcruise",
    "check:env-parity": "node scripts/ci/check-env-parity.mjs",
    "ci:timing": "node scripts/ci/ci-timing.mjs",
    "perf:tests": "node scripts/perf/measure-tests.mjs",
    "perf:api": "node scripts/perf/api-load.mjs",
    "check:windows-paths": "node scripts/ci/check-windows-paths.mjs",
    "check:test-patterns": "node scripts/ci/check-test-patterns.mjs",
    "check:perf-budget": "node scripts/ci/check-perf-budget.mjs",
    "check:public-safety": "node scripts/ci/check-public-safety.mjs",
    "test:public-safety": "node --test scripts/ci/check-public-safety.test.mjs",
    "verify:pr": "node scripts/ci/verify-pr-local.mjs --mode standard",
    "verify:pr:quick": "node scripts/ci/verify-pr-local.mjs --mode quick",
    "verify:pr:full": "node scripts/ci/verify-pr-local.mjs --mode full",
    "verify:pr:clean": "node scripts/ci/verify-pr-local.mjs --clean",
    "verify:pr:status": "node scripts/ci/verify-pr-local.mjs --status",
    "stack:local:up": "node scripts/deploy/stack-local.mjs up",
    "stack:local:down": "node scripts/deploy/stack-local.mjs down",
    "stack:local:reset": "node scripts/deploy/stack-local.mjs reset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
