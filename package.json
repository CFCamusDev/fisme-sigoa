{
  "name": "fisme-sigoa",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Integrado de Gestion de Objetivos Educacionales y Atributos del Graduado (EPIS UNTRM)",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ]
  },
  "scripts": {
    "build:shared": "pnpm --filter @sigoa/shared build",
    "db:generate": "pnpm --filter backend db:generate",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "typecheck": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present typecheck",
    "test": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present test",
    "test:coverage": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present test:coverage",
    "test:e2e": "pnpm build:shared && pnpm db:generate && pnpm --filter frontend test:e2e",
    "build": "pnpm build:shared && pnpm db:generate && pnpm -r --if-present build",
    "depcruise": "pnpm --filter backend --if-present depcruise",
    "check:env-parity": "node scripts/ci/check-env-parity.mjs",
    "verify:pr": "node scripts/ci/verify-pr-local.mjs --mode standard",
    "verify:pr:quick": "node scripts/ci/verify-pr-local.mjs --mode quick",
    "verify:pr:full": "node scripts/ci/verify-pr-local.mjs --mode full",
    "verify:pr:clean": "node scripts/ci/verify-pr-local.mjs --clean",
    "verify:pr:status": "node scripts/ci/verify-pr-local.mjs --status",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
