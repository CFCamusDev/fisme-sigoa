{
  "openapi": "3.1.0",
  "info": {
    "title": "FISME-SIGOA API",
    "version": "0.1.0",
    "description": "API REST del Sistema Integrado de Gestión de Objetivos Educacionales (OE) y Atributos del Graduado (AG) del Programa de Estudios de Ingeniería de Sistemas (EPIS) de la UNTRM, alineado a estándares ICACIT."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de desarrollo local"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión",
        "description": "Autentica al usuario mediante credenciales institucionales. En caso de éxito, emite un access token JWT (duración 15 minutos) y un refresh token seguro (duración 7 días). Bloquea la cuenta temporalmente por 15 minutos tras 5 intentos fallidos consecutivos.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "juan.perez@untrm.edu.pe",
                "password": "Password123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión exitoso. Retorna tokens de autenticación y datos del usuario.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store",
                "description": "Directiva estricta anti-almacenamiento en caché para respuestas con credenciales."
              },
              "Pragma": {
                "schema": {
                  "type": "string"
                },
                "example": "no-cache"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "example": "sigoa_refresh_token=...; Path=/auth; HttpOnly; SameSite=Strict",
                "description": "Cookie HttpOnly sigoa_refresh_token con el token de actualización opaco."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example",
                  "accessTokenExpiresAt": "2026-10-30T10:15:00.000Z",
                  "refreshTokenExpiresAt": "2026-11-06T10:00:00.000Z",
                  "user": {
                    "id": "usr_cuid_123",
                    "names": "Juan Carlos",
                    "firstSurname": "Pérez",
                    "secondSurname": "Gómez",
                    "email": "juan.perez@untrm.edu.pe"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud contiene errores de validación sintáctica en el cuerpo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "La solicitud contiene errores de validación",
                    "details": [
                      {
                        "path": "body.email",
                        "message": "El formato del correo electrónico es inválido"
                      }
                    ],
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas (correo no registrado o contraseña incorrecta). Mensaje genérico para evitar enumeración.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Correo o contraseña incorrectos",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado: cuenta inactiva o pendiente de activación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "accountInactive": {
                    "summary": "Cuenta inactiva",
                    "value": {
                      "error": {
                        "code": "ACCOUNT_INACTIVE",
                        "message": "Tu cuenta se encuentra inactiva. Comunícate con el Administrador del sistema.",
                        "requestId": "req_abc_123"
                      }
                    }
                  },
                  "accountPendingActivation": {
                    "summary": "Cuenta pendiente de activación",
                    "value": {
                      "error": {
                        "code": "ACCOUNT_PENDING_ACTIVATION",
                        "message": "Tu cuenta está pendiente de activación. Revisa tu correo institucional para definir tu contraseña.",
                        "requestId": "req_abc_123"
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Cuenta bloqueada temporalmente por exceso de intentos fallidos o límite de peticiones por IP excedido.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "example": 900,
                "description": "Tiempo en segundos a esperar antes de volver a intentar la autenticación."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "accountLocked": {
                    "summary": "Cuenta bloqueada por 5 intentos fallidos",
                    "value": {
                      "error": {
                        "code": "ACCOUNT_LOCKED",
                        "message": "Tu cuenta ha sido bloqueada temporalmente por exceso de intentos fallidos. Por favor intenta nuevamente en 15 minutos.",
                        "retryAfterSeconds": 900,
                        "requestId": "req_abc_123"
                      }
                    }
                  },
                  "rateLimited": {
                    "summary": "Límite de solicitudes por IP excedido",
                    "value": {
                      "error": {
                        "code": "RATE_LIMITED",
                        "message": "Ha excedido el límite de solicitudes permitidas. Intente nuevamente más tarde.",
                        "requestId": "req_abc_123"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado no controlado en el servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Ha ocurrido un error inesperado en el servidor.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Renovar sesión (rotación de tokens)",
        "description": "Rota el refresh token actual por uno nuevo y emite un nuevo access token de 15 minutos. El refresh token previo queda invalidado de forma inmediata e irreversible (CA1, CA3).",
        "operationId": "refreshSession",
        "responses": {
          "200": {
            "description": "Sesión renovada exitosamente. Retorna nuevos tokens rotados y datos del usuario.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store",
                "description": "Directiva estricta anti-almacenamiento en caché para respuestas con credenciales."
              },
              "Pragma": {
                "schema": {
                  "type": "string"
                },
                "example": "no-cache"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "example": "sigoa_refresh_token=...; Path=/auth; HttpOnly; SameSite=Strict",
                "description": "Cookie HttpOnly rotada sigoa_refresh_token."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.rotated",
                  "accessTokenExpiresAt": "2026-10-30T10:30:00.000Z",
                  "refreshTokenExpiresAt": "2026-11-06T10:15:00.000Z",
                  "user": {
                    "id": "usr_cuid_123",
                    "names": "Juan Carlos",
                    "firstSurname": "Pérez",
                    "secondSurname": "Gómez",
                    "email": "juan.perez@untrm.edu.pe"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud contiene errores de sintaxis o cuerpo mal formado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "La solicitud contiene errores de validación",
                    "details": [
                      {
                        "path": "body.refreshToken",
                        "message": "El token de actualización es obligatorio"
                      }
                    ],
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Refresh token expirado, revocado o desconocido (CA3). Mensaje genérico uniforme.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "La sesión expiró o ya no es válida. Inicia sesión nuevamente.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origen no permitido para peticiones con cookies de autenticación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "Origen no permitido",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de peticiones de sesión excedido para la IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Has excedido el límite de solicitudes. Por favor, intenta nuevamente más tarde.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado no controlado en el servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Ha ocurrido un error inesperado en el servidor.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "refreshCookie": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cerrar sesión",
        "description": "Cierra la sesión activa revocando el refresh token especificado. Requiere autenticación con access token (Bearer JWT) y valida alcance propio (CA2).",
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Sesión cerrada exitosamente. El refresh token fue revocado y ya no permite renovaciones.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "example": "sigoa_refresh_token=; Path=/auth; HttpOnly; Max-Age=0",
                "description": "Limpieza de la cookie de sesión al cerrar sesión."
              }
            }
          },
          "400": {
            "description": "Solicitud contiene errores de sintaxis o cuerpo mal formado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "La solicitud contiene errores de validación",
                    "details": [
                      {
                        "path": "body.refreshToken",
                        "message": "El token de actualización es obligatorio"
                      }
                    ],
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o token de acceso vencido/inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Acceso no autorizado",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Intento de revocar una sesión perteneciente a otro usuario (alcance propio, RS-002).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "No tiene permisos para cerrar la sesión de otro usuario.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de peticiones de sesión excedido para la IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Has excedido el límite de solicitudes. Por favor, intenta nuevamente más tarde.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado no controlado en el servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Ha ocurrido un error inesperado en el servidor.",
                    "requestId": "req_abc_123"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Correo institucional del usuario (normalizado a minúsculas sin espacios exteriores)."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Contraseña en texto plano (máximo 128 caracteres para acotar el costo computacional de hashing)."
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": ["id", "names", "firstSurname", "secondSurname", "email"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único del usuario."
          },
          "names": {
            "type": "string",
            "description": "Nombres del usuario."
          },
          "firstSurname": {
            "type": "string",
            "description": "Primer apellido del usuario."
          },
          "secondSurname": {
            "type": ["string", "null"],
            "description": "Segundo apellido del usuario (puede ser nulo)."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Correo electrónico institucional del usuario."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["accessToken", "accessTokenExpiresAt", "refreshTokenExpiresAt", "user"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Token JWT firmado con algoritmo HS256 válido por 15 minutos."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora ISO 8601 de expiración del token de acceso."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora ISO 8601 de expiración del refresh token."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        }
      },
      "ValidationDetail": {
        "type": "object",
        "required": ["path", "message"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Ruta del campo con error."
          },
          "message": {
            "type": "string",
            "description": "Mensaje descriptivo del error de validación."
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "NOT_FOUND",
                  "FORBIDDEN",
                  "CONFLICT",
                  "INTERNAL_ERROR",
                  "RATE_LIMITED",
                  "UNAUTHORIZED",
                  "ACCOUNT_LOCKED",
                  "ACCOUNT_INACTIVE",
                  "ACCOUNT_PENDING_ACTIVATION"
                ],
                "description": "Código machine-readable del error estándar."
              },
              "message": {
                "type": "string",
                "description": "Mensaje legible en español explicando la causa del error."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ValidationDetail"
                },
                "description": "Detalles específicos de campos fallidos en errores de validación."
              },
              "requestId": {
                "type": "string",
                "description": "Identificador de trazabilidad de la solicitud."
              },
              "retryAfterSeconds": {
                "type": "integer",
                "description": "Segundos a esperar antes de reintentar en bloqueos de cuenta."
              }
            }
          }
        }
      },
      "RefreshResponse": {
        "$ref": "#/components/schemas/LoginResponse"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de acceso JWT firmado con HS256 emitido en /auth/login o /auth/refresh (duración 15 minutos)."
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sigoa_refresh_token",
        "description": "Cookie HttpOnly con el token de actualización emitida en /auth/login o /auth/refresh."
      }
    }
  }
}
