// ==============================================================================
// FISME-SIGOA — Esquema de Base de Datos Prisma (PostgreSQL)
// ==============================================================================
// Convenciones obligatorias del esquema (LS s.4, RS-070, RS-071, RNF-022, RNF-027):
//
// 1. Nombres y Mapeos:
//    - Modelos en PascalCase singular (ej: model ProcessExecution).
//    - Tablas en PostgreSQL mapeadas explícitamente a snake_case plural con @@map (ej: @@map("process_executions")).
//    - Atributos y columnas en camelCase directo sin renombrar salvo requerimiento específico.
//    - Enums en SCREAMING_SNAKE_CASE con valores en inglés alineados al glosario oficial (AGENTS.md §7.1).
//
// 2. Claves primarias y Marcas temporales:
//    - Clave primaria obligatoria: id String @id @default(cuid()).
//    - Marcas de tiempo de auditoría técnica:
//        createdAt DateTime @default(now())
//        updatedAt DateTime @updatedAt
//
// 3. Auditoría de Autoría (sin relación de clave foránea forzada):
//    - createdBy String?  (ID del usuario que creó el registro o 'SYSTEM'/'SEED')
//    - updatedBy String?  (ID del último usuario que modificó el registro)
//    - No declarar relación @relation hacia User para evitar acoplamientos circulares y permitir actores del sistema.
//
// 4. Inmutabilidad y Anulación Lógica (RS-070, RS-071, RN-007):
//    - Los registros con valor de evidencia NUNCA se eliminan físicamente (DELETE prohibido).
//    - Campos estándar de anulación lógica:
//        voided Boolean @default(false)
//        voidReason String?
//        voidedBy String?
//        voidedAt DateTime?
//    - Borrado físico solo admisible en borradores transitorios (DRAFT).
//
// 5. Relaciones e Índices:
//    - Claves foráneas nombradas como <entidadRelacionada>Id (ej: courseOfferingId String).
//    - Cada clave foránea debe contar con su índice explícito: @@index([courseOfferingId]).
//    - Restricciones de unicidad compuestas con @@unique([...]).
//    - Consultas frecuentes con filtros combinados deben definir índices con @@index([...]).
//
// 6. Auditoría Append-Only (HU-075):
//    - La tabla AuditLog es exclusivamente de inserción; nunca se ejecutan UPDATE ni DELETE.
//    - Excepción justificada a las convenciones generales: sin updatedAt, updatedBy ni campos de anulación lógica (inmutable y append-only).
//
// ------------------------------------------------------------------------------
// MODELO DE EJEMPLO (COMENTADO DE REFERENCIA):
// ------------------------------------------------------------------------------
// enum ExampleStatus {
//   DRAFT
//   IN_PROGRESS
//   APPROVED
//   CLOSED
//   VOIDED
// }
//
// model ExampleEntity {
//   id          String        @id @default(cuid())
//   code        String
//   title       String
//   status      ExampleStatus @default(DRAFT)
//
//   // Relación con otra entidad
//   programId   String
//   // program     Program       @relation(fields: [programId], references: [id])
//
//   // Auditoría técnica de autoría
//   createdBy   String?
//   updatedBy   String?
//
//   // Marcas temporales
//   createdAt   DateTime      @default(now())
//   updatedAt   DateTime      @updatedAt
//
//   // Anulación lógica (RS-070)
//   voided      Boolean       @default(false)
//   voidReason  String?
//   voidedBy    String?
//   voidedAt    DateTime?
//
//   // Índices y restricciones
//   @@unique([programId, code])
//   @@index([programId])
//   @@index([status])
//   @@map("example_entities")
// }
// ==============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/shared/prisma/generated"
}

// ------------------------------------------------------------------------------
// Auditoría Append-Only (HU-075, RS-040, RS-041, RS-042, RS-043)
// ------------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  STATE_CHANGE
  VOID
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ROLE_CHANGE
  PERMISSION_CHANGE
  PARAMETER_CHANGE
  DOWNLOAD
  PUBLIC_RESPONSE
  ACCESS_DENIED
}

model AuditLog {
  id           String      @id @default(cuid())
  sequence     BigInt      @unique
  occurredAt   DateTime
  actor        String
  ip           String?
  requestId    String?
  action       AuditAction
  entity       String
  entityId     String
  before       Json?
  after        Json?
  previousHash String?
  hash         String      @unique

  @@index([entity, entityId])
  @@index([actor])
  @@index([occurredAt])
  @@map("audit_logs")
}

model AuditChainHead {
  id        String   @id // 'MAIN' (excepción documentada a cuid(): puntero técnico único de cabeza)
  sequence  BigInt
  hash      String
  updatedAt DateTime @updatedAt

  @@map("audit_chain_heads")
}

// ------------------------------------------------------------------------------
// Archivos almacenados (HU-076, LS s.4.13, RS-072, RNF-013)
// ------------------------------------------------------------------------------

model StoredFile {
  id        String   @id @default(cuid())
  provider  String
  publicId  String
  url       String
  mimeType  String
  sizeBytes Int
  sha256    String
  createdAt DateTime @default(now())

  resolution Resolution?

  @@unique([provider, publicId])
  @@map("stored_files")
}

// ------------------------------------------------------------------------------
// Usuarios y Autenticación (HU-001, LS s.4.1, LS s.5.14, RF-001, RS-015, RS-016)
// ------------------------------------------------------------------------------

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
}

model User {
  id                  String     @id @default(cuid())
  names               String
  firstSurname        String
  secondSurname       String?
  email               String     @unique
  dni                 String?    @unique
  passwordHash        String?
  status              UserStatus @default(PENDING_ACTIVATION)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // Relaciones
  refreshTokens    RefreshToken[]
  userRoles        UserRole[]
  activationTokens ActivationToken[]
  userPermissions  UserPermission[]

  // Auditoría técnica de autoría
  createdBy String?
  updatedBy String?

  // Marcas temporales
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdByIp String?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([userId])
  @@map("activation_tokens")
}

// ==============================================================================
// MÓDULO DE AUTORIZACIÓN (HU-006, HU-007, HU-008, cimientos HU-003)
// ==============================================================================

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionScope {
  GLOBAL
  OWN
}

model Role {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String     @unique
  description   String?
  status        RoleStatus @default(ACTIVE)
  deactivatedAt DateTime?
  isPredefined  Boolean    @default(false)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  module      String
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String          @id @default(cuid())
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  scope        PermissionScope @default(GLOBAL)
  createdAt    DateTime        @default(now())
  createdBy    String?
  updatedAt    DateTime        @default(now()) @updatedAt
  updatedBy    String?

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  scope        PermissionScope @default(GLOBAL)
  createdAt    DateTime        @default(now())
  createdBy    String?
  updatedAt    DateTime        @default(now()) @updatedAt
  updatedBy    String?

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ==============================================================================
// MÓDULO DE PARÁMETROS (HU-009)
// ==============================================================================

model Program {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  faculty   String
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogVersions   CatalogVersion[]
  stakeholderLists  StakeholderList[]
  processExecutions ProcessExecution[]
  qualityCommittees QualityCommittee[]

  @@map("programs")
}

// ==============================================================================
// GESTIÓN DE SEMESTRES (HU-010)
// ==============================================================================

model Semester {
  id        String   @id @default(cuid())
  code      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parameters        Parameter[]
  processExecutions ProcessExecution[]

  @@index([startDate])
  @@map("semesters")
}

model Parameter {
  id                      String   @id @default(cuid())
  key                     String
  value                   Int
  effectiveFromSemesterId String?
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  effectiveFromSemester Semester? @relation(fields: [effectiveFromSemesterId], references: [id], onDelete: Restrict)

  @@unique([key, effectiveFromSemesterId])
  @@index([key])
  @@map("parameters")
}

// ==============================================================================
// ESCALAS DE RESPUESTA (HU-012)
// ==============================================================================

enum ScaleType {
  LIKERT
  NUMERIC
  EVIDENCE
}

model ResponseScale {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  type      ScaleType
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  levels ScaleLevel[]

  @@map("response_scales")
}

model ScaleLevel {
  id                  String   @id @default(cuid())
  scaleId             String
  order               Int
  label               String
  value               Int
  countsAsAchievement Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scale ResponseScale @relation(fields: [scaleId], references: [id], onDelete: Restrict)

  @@unique([scaleId, order])
  @@unique([scaleId, value])
  @@index([scaleId])
  @@map("scale_levels")
}

// ==============================================================================
// CATÁLOGO DE OE Y AG (HU-013)
// ==============================================================================

enum CatalogVersionStatus {
  DRAFT
  IN_VALIDATION
  APPROVED
  HISTORICAL
}

model CatalogVersion {
  id               String               @id @default(cuid())
  programId        String
  number           Int
  status           CatalogVersionStatus @default(DRAFT)
  basedOnVersionId String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  program         Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  basedOnVersion  CatalogVersion?        @relation("CatalogVersionOrigin", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions CatalogVersion[]       @relation("CatalogVersionOrigin")
  objectives      EducationalObjective[]
  attributes        GraduateAttribute[]
  resolutions       Resolution[]
  processExecutions ProcessExecution[]

  @@unique([programId, number])
  @@index([programId, status])
  @@map("catalog_versions")
}

model EducationalObjective {
  id        String   @id @default(cuid())
  versionId String
  code      String
  statement String
  order     Int
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version CatalogVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, code])
  @@unique([versionId, order])
  @@index([versionId])
  @@map("educational_objectives")
}

model GraduateAttribute {
  id        String   @id @default(cuid())
  versionId String
  code      String
  name      String
  statement String
  order     Int
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version CatalogVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, code])
  @@unique([versionId, order])
  @@index([versionId])
  @@map("graduate_attributes")
}

// ==============================================================================
// RESOLUCIONES (HU-048, RF-048, RN-063, RN-064)
// ==============================================================================

enum ResolutionType {
  EDUCATIONAL_OBJECTIVE
  GRADUATE_ATTRIBUTE
  IMPROVEMENT_PLAN
}

enum ResolutionStatus {
  REGISTERED
  APPROVED
}

model Resolution {
  id               String           @id @default(cuid())
  type             ResolutionType
  number           String
  issuedOn         DateTime         @db.Date
  status           ResolutionStatus @default(REGISTERED)
  catalogVersionId String?
  pdfFileId        String?          @unique
  approvedAt       DateTime?
  approvedBy       String?
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  catalogVersion CatalogVersion? @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  pdfFile        StoredFile?     @relation(fields: [pdfFileId], references: [id], onDelete: Restrict)

  @@unique([number, type])
  @@unique([catalogVersionId, type])
  @@index([status])
  @@map("resolutions")
}

// ==============================================================================
// PLANTILLAS OFICIALES (HU-018, RF-018, RN-004, RN-040, RS-024)
// ==============================================================================

enum TemplateType {
  ANNEX
  MINUTES
  SURVEY
  INSTRUMENT
}

model Template {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  type      TemplateType
  variables Json         @default("[]")
  createdBy String?
  updatedBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  versions TemplateVersion[]

  @@index([type])
  @@map("templates")
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  OBSOLETE
}

model TemplateVersion {
  id          String                @id @default(cuid())
  templateId  String
  number      Int
  status      TemplateVersionStatus @default(DRAFT)
  content     String                @db.Text
  publishedAt DateTime?
  publishedBy String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, number])
  @@index([templateId, status])
  @@map("template_versions")
}

// ==============================================================================
// CONSTITUYENTES (HU-021, RF-021, RS-037)
// ==============================================================================

enum StakeholderKind {
  PERSON
  INSTITUTION
}

enum StakeholderStatus {
  ACTIVE
  VOIDED
}

model Stakeholder {
  id             String            @id @default(cuid())
  kind           StakeholderKind
  fullName       String
  dni            String?           @unique
  ruc            String?           @unique
  email          String?
  mobile         String?
  position       String?
  institution    String?
  sector         String?
  graduationYear Int?
  cycle          String?
  status         StakeholderStatus @default(ACTIVE)
  voidReason     String?
  voidedAt       DateTime?
  voidedBy       String?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  listMemberships StakeholderListMember[]

  @@index([status])
  @@index([fullName])
  @@map("stakeholders")
}

// ==============================================================================
// LISTAS DEL ANEXO 3 (HU-022, RF-022, RS-037)
// ==============================================================================

enum StakeholderListType {
  ADVISORY_BOARD
  EMPLOYER
  GRADUATE
  STUDENT
  TEACHER
}

model StakeholderList {
  id              String              @id @default(cuid())
  programId       String
  type            StakeholderListType
  year            Int
  studyPlanNumber String?
  version         String?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  program Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  members StakeholderListMember[]
  sessions Session[]

  @@unique([programId, type, year])
  @@index([type, year])
  @@map("stakeholder_lists")
}

model StakeholderListMember {
  id             String   @id @default(cuid())
  listId         String
  stakeholderId  String
  fullName       String
  institution    String?
  ruc            String?
  sector         String?
  representative String?
  activity       String?
  email          String?
  mobile         String?
  position       String?
  graduationYear Int?
  cycle          String?
  createdBy      String
  createdAt      DateTime @default(now())

  list        StakeholderList @relation(fields: [listId], references: [id], onDelete: Restrict)
  stakeholder Stakeholder     @relation(fields: [stakeholderId], references: [id], onDelete: Restrict)
  attendees   Attendee[]

  @@unique([listId, stakeholderId])
  @@index([stakeholderId])
  @@map("stakeholder_list_members")
}

// ==============================================================================
// EJECUCIONES DE PROCESO (HU-027, RF-027, RS-001)
// ==============================================================================

enum ProcessType {
  P611
  P612
  P613
  P621
  P622
  P623
}

enum ProcessExecutionStatus {
  PLANNED
  IN_PROGRESS
  CONSOLIDATING
  PENDING_APPROVAL
  CLOSED
  VOIDED
}

model ProcessExecution {
  id               String                 @id @default(cuid())
  programId        String
  type             ProcessType
  name             String
  year             Int
  semesterId       String?
  catalogVersionId String
  status           ProcessExecutionStatus @default(PLANNED)
  createdBy        String
  updatedBy        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  program        Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  semester       Semester?          @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  catalogVersion CatalogVersion     @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  sessionLinks   SessionExecution[]

  @@index([type, year])
  @@index([status])
  @@index([catalogVersionId])
  @@index([semesterId])
  @@map("process_executions")
}

// ==============================================================================
// SESIONES CON CONSTITUYENTES (HU-032, RF-032, RS-030)
// ==============================================================================

enum SessionModality {
  VIRTUAL
  IN_PERSON
  HYBRID
}

model Session {
  id                String              @id @default(cuid())
  stakeholderType   StakeholderListType
  stakeholderListId String?
  sessionDate       DateTime            @db.Date
  startTime         String
  modality          SessionModality
  meetingUrl        String?
  recordingUrl      String?
  createdBy         String
  updatedBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  stakeholderList StakeholderList?   @relation(fields: [stakeholderListId], references: [id], onDelete: Restrict)
  executions      SessionExecution[]
  attendees       Attendee[]

  @@unique([stakeholderType, sessionDate, startTime])
  @@index([stakeholderListId])
  @@index([sessionDate])
  @@map("sessions")
}

model SessionExecution {
  id                 String   @id @default(cuid())
  sessionId          String
  processExecutionId String
  createdBy          String
  createdAt          DateTime @default(now())

  session          Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  processExecution ProcessExecution @relation(fields: [processExecutionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, processExecutionId])
  @@index([processExecutionId])
  @@map("session_executions")
}

model Attendee {
  id           String   @id @default(cuid())
  sessionId    String
  listMemberId String
  position     String?
  createdBy    String
  createdAt    DateTime @default(now())

  session    Session               @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  listMember StakeholderListMember @relation(fields: [listMemberId], references: [id], onDelete: Restrict)

  @@unique([sessionId, listMemberId])
  @@index([listMemberId])
  @@map("attendees")
}

// ==============================================================================
// COMITÉ DE CALIDAD (HU-025, RF-025, RS-034, RN-062)
// ==============================================================================

model QualityCommittee {
  id          String   @id @default(cuid())
  programId   String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([programId, periodStart])
  @@map("quality_committees")
}
