# Configuración del entorno del backend FISME-SIGOA
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Seguridad HTTP y CORS
CORS_ORIGIN="http://localhost:5173"
HSTS_ENABLED=true
TRUST_PROXY=0

# Rate Limiting (solicitudes por ventana de tiempo en ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SESSION_MAX=30
RATE_LIMIT_GENERAL_MAX=300

# Base de datos PostgreSQL (variable crítica obligatoria)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigoa_dev?schema=public"

# Rol de aplicación restringido para aprovisionamiento con `pnpm run db:provision-app-role` (RS-040, RNF-014)
APP_DB_USER=sigoa_backend
APP_DB_PASSWORD=sigoa_backend_dev_pass

# Base de datos de pruebas para tests de integración (el nombre debe terminar estrictamente en _test)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigoa_test?schema=public"
# Bases de datos por worker en pruebas de integración (solo pruebas; por defecto min(4, núcleos/2), 1 en el CI)
# TEST_DB_WORKERS=4
# Reseteo entre pruebas: por defecto incremental; "truncate" limpia todas las tablas
# TEST_DB_RESET=truncate

# Proveedor de correo electrónico (RS-073, RNF-033: resend | memory)
EMAIL_PROVIDER=memory
RESEND_API_KEY=""
EMAIL_FROM=""

# Proveedor de almacenamiento de archivos (RS-072, RNF-013: cloudinary | memory)
FILE_STORAGE_PROVIDER=memory
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Generador PDF Puppeteer (RS-063, RNF-021)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
PDF_CHROMIUM_NO_SANDBOX=false

# Autenticación y cookies de sesión (HU-001, HU-002, RNF-004)
# AUTH_COOKIE_SAMESITE: strict | lax | none (none solo permitido con NODE_ENV=production y HTTPS)
AUTH_COOKIE_SAMESITE=strict
APP_PUBLIC_URL="http://localhost:5173"
# AUTH_JWT_SECRET="secreto-aleatorio-de-al-menos-32-caracteres-en-produccion"
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
