# Configuración del entorno del backend FISME-SIGOA
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Seguridad HTTP y CORS
CORS_ORIGIN="http://localhost:5173"
HSTS_ENABLED=true
TRUST_PROXY=0

# Rate Limiting (solicitudes por ventana de tiempo en ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_GENERAL_MAX=300

# Base de datos PostgreSQL (variable crítica obligatoria)
DATABASE_URL="postgresql://user:password@localhost:5432/fisme_sigoa?schema=public"
