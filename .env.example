# ==============================================================================
# Variables de entorno para Docker Compose en desarrollo local (docker-compose.yml)
# Copia este archivo a .env en la raíz del proyecto para personalizar valores si es necesario.
# ==============================================================================

# Base de datos PostgreSQL
DB_NAME=sigoa_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# Rol de aplicación restringido para el backend (RS-040, RNF-014)
# Solo letras, números, _ y -, mínimo 16 caracteres para la contraseña
APP_DB_USER=sigoa_backend
APP_DB_PASSWORD=sigoa_backend_dev_pass

# Primer administrador (RNF-039): lo crea `migrate` / `pnpm --filter backend db:seed` solo si no existe ninguno.
# Valores ficticios de desarrollo; docker-compose.yml usa estos mismos por defecto.
ADMIN_EMAIL=admin@sigoa.test
ADMIN_FULL_NAME=Administrador Desarrollo Local
ADMIN_DNI=10000001
ADMIN_INITIAL_PASSWORD=DesarrolloLocal2026

# Servidor Backend (API Express)
SERVER_PORT=3000
LOG_LEVEL=info
HSTS_ENABLED=false
TRUST_PROXY=0

# Rate Limiting (solicitudes por ventana de tiempo en ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SESSION_MAX=30
RATE_LIMIT_GENERAL_MAX=300

# Proveedor de correo electrónico (RS-073, RNF-033: resend | memory)
EMAIL_PROVIDER=memory
RESEND_API_KEY=""
EMAIL_FROM=""

# Proveedor de almacenamiento de archivos (RS-072, RNF-013: cloudinary | memory)
FILE_STORAGE_PROVIDER=memory
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Generador PDF Puppeteer (RS-063, RNF-021)
PDF_CHROMIUM_NO_SANDBOX=false

# Autenticación y JWT (HU-001, RS-016, RNF-004)
# En producción debe ser un secreto aleatorio de al menos 32 caracteres
AUTH_JWT_SECRET=""
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_COOKIE_SAMESITE=strict

# Frontend SPA (Nginx)
FRONTEND_PORT=8001
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8001
APP_PUBLIC_URL=http://localhost:8001

# Servicio de Respaldo PostgreSQL (postgres-backup-local)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=0
BACKUP_KEEP_MONTHS=0
