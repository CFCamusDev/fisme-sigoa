# ==============================================================================
# Variables de entorno para Docker Compose en desarrollo local (docker-compose.yml)
# Copia este archivo a .env en la raíz del proyecto para personalizar valores si es necesario.
# ==============================================================================

# Base de datos PostgreSQL
DB_NAME=sigoa_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# Rol de aplicación restringido para el backend (RS-040, RNF-014)
# Solo letras, números, _ y -, mínimo 16 caracteres para la contraseña
APP_DB_USER=sigoa_backend
APP_DB_PASSWORD=sigoa_backend_dev_pass

# Servidor Backend (API Express)
SERVER_PORT=3000
LOG_LEVEL=info
HSTS_ENABLED=false
TRUST_PROXY=0

# Proveedor de correo electrónico (RS-073, RNF-033: resend | memory)
EMAIL_PROVIDER=memory
RESEND_API_KEY=""
EMAIL_FROM=""

# Frontend SPA (Nginx)
FRONTEND_PORT=8001
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8001

# Servicio de Respaldo PostgreSQL (postgres-backup-local)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=0
BACKUP_KEEP_MONTHS=0
